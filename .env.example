# Database
MONGODB_URI=mongodb://localhost:27017/hellomd

# NextAuth
AUTH_SECRET=your_auth_secret_minimum_32_characters_here
GITHUB_ID=
GITHUB_SECRET=

# GitHub API Token (read-only for anonymous fetching)
GITHUB_SERVER_TOKEN=

# Token Encryption (32 bytes base64 encoded)
TOKEN_ENC_KEY=

# AI Providers
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Limits & Timeouts
DAILY_GENERATIONS=3
AI_TIMEOUT_MS=20000
